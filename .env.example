# Copy to .env.local (git-ignored). All keys are optional.

# FEC-processed independent-expenditure totals (free): https://api.data.gov/signup/
FEC_API_KEY=

# 50-state bill discovery & status (free): https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=

# Optional: federal bill status already comes from GovInfo bulk data without a key.
CONGRESS_GOV_API_KEY=

# Set to 0 to disable the in-process auto-refresh scheduler.
AUTO_REFRESH=1
